# ============================================
# AUTO NEWS SCRAPER - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Telegram User Client (for scraping channels) ---
# Get these from https://my.telegram.org
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# --- Telegram Bot (for sending to your channel) ---
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=-1001234567890

# --- X (Twitter) API ---
# Get from https://developer.x.com
X_BEARER_TOKEN=your_bearer_token_here

# --- Facebook Page ---
# Get from https://developers.facebook.com
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_POSTING_ENABLED=true

# --- Instagram ---
# Get from Meta Business Suite → Graph API Explorer
INSTAGRAM_ACCOUNT_ID=your_ig_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_ig_access_token_here
INSTAGRAM_POSTING_ENABLED=true

# --- Dashboard ---
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change_this_to_a_random_string
